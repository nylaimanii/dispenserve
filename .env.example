# Copy to .env (gitignored) and fill in what you have. Everything is optional:
# anything missing is logged at startup and that integration falls back or turns off.
# SETUP_KEYS.md says where to get each one.

# --- this machine ---
MACHINE_ID=library-2f
BAY_NAME=Kit Kat
BAY_CAPACITY=24

# --- Tiger Data (TimescaleDB): anonymous event telemetry + fleet API ---
TIGER_DATABASE_URL=

# --- Snowflake: the same anonymous events, for analytics ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- Solana devnet: public donor ledger (restocks + daily totals, never people) ---
# create with: .venv/bin/python vision/ledger.py --new-keypair ~/.config/dispenserve/devnet.json
SOLANA_KEYPAIR_PATH=
# fleet API only: the machines' wallet addresses, comma-separated (printed by ledger.py --balance)
SOLANA_LEDGER_ADDRESSES=

# --- Gemini: 2 sentence restock recommendation at GET /insights (aggregate counts only) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# --- ElevenLabs: generates the fixed kiosk lines once, cached in vision/audio/ ---
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_multilingual_v2

# --- this laptop ---
# OpenCV index of the camera to use (leave unset to try 1 then 0)
CAMERA_INDEX=
