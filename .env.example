# Copy to .env (gitignored) and fill in what you have. Everything is optional:
# anything missing is logged at startup and that integration falls back or turns off.
# SETUP_KEYS.md says where to get each one.

# --- this machine ---
MACHINE_ID=library-2f
BAY_NAME=Kit Kat
BAY_CAPACITY=24

# --- Tiger Data (TimescaleDB): anonymous event telemetry + fleet API ---
TIGER_DATABASE_URL=

# --- Snowflake: the same anonymous events, for analytics ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
